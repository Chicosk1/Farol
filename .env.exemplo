# Modelo do arquivo .env do Docker Compose. Para usar: cp .env.exemplo .env
# O .env fica fora do Git: segredos e chaves nunca vão para o repositório.
# Sem .env, o Docker Compose usa estes mesmos valores, que só servem para desenvolvimento.

# Django
DJANGO_SETTINGS_MODULE=farol.configuracoes.desenvolvimento
DJANGO_SECRET_KEY=troque-esta-chave-no-seu-computador
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL com pgvector (serviço db)
POSTGRES_DB=farol
POSTGRES_USER=farol
POSTGRES_PASSWORD=farol

# Remetente dos e-mails (no desenvolvimento, eles aparecem no Mailpit: http://localhost:8025)
DEFAULT_FROM_EMAIL=Farol <nao-responda@farol.local>

# UID do seu usuário no Linux ou no WSL (rode: id -u), para que os arquivos criados
# pelos containers, como as migrações, tenham você como dono
FAROL_UID=1000

# Pasta dos arquivos enviados (PDFs dos professores e importações). No Docker Compose já é /arquivos,
# um volume compartilhado pelo backend e pelo worker; em produção, aponte para um disco com backup
FAROL_ARQUIVOS=/arquivos

# Segredo do identificador pseudônimo do aluno nos registros de uso do tutor (TUT-RF-12).
# Em produção é obrigatório e fica só no servidor
FAROL_SEGREDO_PSEUDONIMO=troque-este-segredo

# Provedor de IA (ADR 0009). Sem a variável, vale o adaptador falso, que não usa modelo nenhum.
# Para usar o Ollama (docker compose --profile ia up), descomente a linha abaixo.
# FAROL_IA_ADAPTADOR=ia.adaptadores.compativel_openai.ProvedorCompativelOpenAI
# Similaridade mínima do tutor calibrada para o embeddinggemma com o avaliar_tutor (sem a linha,
# vale 0.15 no desenvolvimento, para o adaptador falso). Descomente junto com a linha de cima
# FAROL_TUTOR_SIMILARIDADE_MINIMA=0.35
# Endereço, modelos e chave do provedor compatível com a API da OpenAI. Os padrões são os do Ollama
# do Docker Compose; um provedor de mercado compatível precisa do endereço dele e da chave
FAROL_IA_ENDERECO=http://ollama:11434/v1
FAROL_IA_MODELO_DE_RESPOSTAS=gemma3:4b
FAROL_IA_MODELO_DE_VETORES=embeddinggemma
FAROL_IA_CHAVE=

# Login com o Google Workspace da instituição (ACE-RF-01). Só entra e-mail verificado deste domínio.
# A credencial OAuth vem do Google Cloud Console (passo a passo em docs/desenvolvimento.md).
# Sem ela, a tela de entrada mostra só o login de desenvolvimento. Em produção, as três são obrigatórias
FAROL_DOMINIO_INSTITUCIONAL=exemplo.edu.br
FAROL_GOOGLE_CLIENT_ID=
FAROL_GOOGLE_SECRET=

# Horas sem uso até a sessão expirar (ACE-RNF-02). Sugestão da spec: 12.
FAROL_SESSAO_HORAS=12
