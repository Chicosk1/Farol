# Modelo do arquivo .env do Docker Compose. Para usar: cp .env.exemplo .env
# O .env fica fora do Git: segredos e chaves nunca vão para o repositório.
# Sem .env, o Docker Compose usa estes mesmos valores, que só servem para desenvolvimento.

# Django
DJANGO_SETTINGS_MODULE=farol.configuracoes.desenvolvimento
DJANGO_SECRET_KEY=troque-esta-chave-no-seu-computador
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL com pgvector (serviço db)
POSTGRES_DB=farol
POSTGRES_USER=farol
POSTGRES_PASSWORD=farol

# Remetente dos e-mails (no desenvolvimento, eles aparecem no Mailpit: http://localhost:8025)
DEFAULT_FROM_EMAIL=Farol <nao-responda@farol.local>

# UID do seu usuário no Linux ou no WSL (rode: id -u), para que os arquivos criados
# pelos containers, como as migrações, tenham você como dono
FAROL_UID=1000

# Pasta dos arquivos enviados (PDFs dos professores e importações). No Docker Compose já é /arquivos,
# um volume compartilhado pelo backend e pelo worker; em produção, aponte para um disco com backup
FAROL_ARQUIVOS=/arquivos

# Segredo do identificador pseudônimo do aluno nos registros de uso do tutor (TUT-RF-12).
# Em produção é obrigatório e fica só no servidor
FAROL_SEGREDO_PSEUDONIMO=troque-este-segredo

# Horas sem uso até a sessão expirar (ACE-RNF-02). Sugestão da spec: 12.
FAROL_SESSAO_HORAS=12
